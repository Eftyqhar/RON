# ==============================================================================
# R.O.N. Environment Variables Configuration
# Copy this file to .env and fill in your keys:
#   copy .env.example .env
# ==============================================================================

# Primary LLM API Key (OpenAI-compatible endpoint):
OPENAI_API_KEY=your_openai_or
# Weather Location Override (Optional, e.g. "Dhaka" or "Sirajganj, Bangladesh"):
# RON_LOCATION=Dhaka

# Spoken Voice Settings (Edge-TTS Neural):
# RON_VOICE=en-GB-RyanNeural
# RON_VOICE_BN=bn-BD-PradeepNeural
# RON_NEURAL_TTS=1

# Telegram Uplink Bot Token (Optional, for phone remote control):
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
